{
  "id": "demand_page",
  "label": "Demand Page",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": "e.g., whs-management-software-australia"
        }
      },
      "page_type": {
        "type": "Select",
        "config": {
          "label": "Page Type",
          "options": [
            "core_intent",
            "competitor_alternative",
            "module_workflow",
            "partner_program"
          ],
          "default_value": "core_intent"
        }
      },
      "primary_keyword": {
        "type": "Text",
        "config": {
          "label": "Primary Keyword",
          "placeholder": "e.g., WHS management software Australia"
        }
      },
      "search_intent": {
        "type": "Text",
        "config": {
          "label": "Search Intent",
          "placeholder": "e.g., Core category commercial investigation"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "H1 Title",
          "placeholder": "Keyword-aligned page heading"
        }
      },
      "subtitle": {
        "type": "Text",
        "config": {
          "label": "Subtitle",
          "placeholder": "Short conversion-focused value proposition"
        }
      },
      "trust_statement": {
        "type": "Text",
        "config": {
          "label": "Trust Statement",
          "placeholder": "Built by safety professionals with 30+ years of experience."
        }
      },
      "primary_cta_label": {
        "type": "Text",
        "config": {
          "label": "Primary CTA Label",
          "placeholder": "Book a WHS Software Demo"
        }
      },
      "primary_cta_url": {
        "type": "Text",
        "config": {
          "label": "Primary CTA URL",
          "placeholder": "/book-a-demo?source=demand&page=..."
        }
      },
      "secondary_cta_label": {
        "type": "Text",
        "config": {
          "label": "Secondary CTA Label",
          "placeholder": "Optional secondary CTA"
        }
      },
      "secondary_cta_url": {
        "type": "Text",
        "config": {
          "label": "Secondary CTA URL",
          "placeholder": "Optional secondary CTA URL"
        }
      }
    },
    "Content": {
      "pain_points": {
        "type": "Group",
        "config": {
          "label": "Pain Points",
          "repeat": true,
          "fields": {
            "title": {
              "type": "Text",
              "config": {
                "label": "Title"
              }
            },
            "description": {
              "type": "Text",
              "config": {
                "label": "Description"
              }
            }
          }
        }
      },
      "capabilities": {
        "type": "Group",
        "config": {
          "label": "Capabilities",
          "repeat": true,
          "fields": {
            "title": {
              "type": "Text",
              "config": {
                "label": "Title"
              }
