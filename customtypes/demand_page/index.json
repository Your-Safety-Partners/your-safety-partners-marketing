              "config": {
                "label": "Answer"
              }
            }
          }
        }
      },
      "internal_links": {
        "type": "Group",
        "config": {
          "label": "Internal Links",
          "repeat": true,
          "fields": {
            "label": {
              "type": "Text",
              "config": {
                "label": "Label"
              }
            },
            "url": {
              "type": "Text",
              "config": {
                "label": "URL"
              }
            }
