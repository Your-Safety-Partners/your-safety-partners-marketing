            "ysp_position": {
              "type": "Text",
              "config": {
                "label": "YSP Position"
              }
            },
            "alternative_position": {
              "type": "Text",
              "config": {
                "label": "Alternative Position"
              }
            }
          }
        }
      },
      "proof_quote": {
        "type": "Text",
        "config": {
