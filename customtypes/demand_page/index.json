            "description": {
              "type": "Text",
              "config": {
                "label": "Description"
              }
            }
          }
        }
      },
      "workflow_steps": {
        "type": "Group",
        "config": {
          "label": "Workflow Steps",
          "repeat": true,
          "fields": {
            "step_title": {
              "type": "Text",
              "config": {
                "label": "Step Title"
